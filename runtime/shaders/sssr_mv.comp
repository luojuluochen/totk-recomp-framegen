#version 450
// The motion vectors FidelityFX SSSR reprojects its history with, made from the scene camera alone: the port's own
// vectors carry the per-object pass's jitter and the moving objects' placements, and the reflections of a static
// floor only need where the camera was. The linear depth comes from sssr_prep.comp's material texture (B), and
// prevVP * invView, precomputed on the CPU, takes the view-space point to last frame's clip space.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D material;               // b: view distance
layout(binding = 1, rg16f) uniform image2D mv_out;            // previous - current, in UV

layout(push_constant) uniform Params {
    vec4 proj;    // x, y projection scales, unused, unused
    vec4 size;    // width, height, 1/width, 1/height
    vec4 m0, m1, m2, m3;   // prevVP * invView, columns
} pc;

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.size.x) || px.y >= int(pc.size.y)) return;
    float z = texelFetch(material, px, 0).b;
    if (z <= 0.0 || z > 1.0e4) {   // nothing drawn: the history is not read there anyway
        imageStore(mv_out, px, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    vec2 uv = (vec2(px) + 0.5) * pc.size.zw;
    vec2 ndc = uv * 2.0 - 1.0;
    vec3 p = vec3(ndc.x * z / pc.proj.x, -ndc.y * z / pc.proj.y, -z);   // view space
    vec4 clip = mat4(pc.m0, pc.m1, pc.m2, pc.m3) * vec4(p, 1.0);
    if (abs(clip.w) < 1e-6) {
        imageStore(mv_out, px, vec4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    vec2 prev_ndc = clip.xy / clip.w;
    vec2 prev_uv = prev_ndc * 0.5 + 0.5;
    imageStore(mv_out, px, vec4(prev_uv - uv, 0.0, 0.0));
}
