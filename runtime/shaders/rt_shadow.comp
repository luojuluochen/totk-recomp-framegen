#version 460
// Ray-traced sun shadows (runtime/vk_rt.c, TOTK_RT=bvh). Each pixel of the game's lit scene colour on a surface facing
// the sun traces one ray toward the sun against the frame's TLAS and darkens the colour where the ray meets geometry
// the game's own shadow maps missed (off-screen casters, thin and distant ones). The TLAS is built in view space, so the
// same view-space position, sun direction and composite point as the contact shadows serve: this pass only takes away
// direct sunlight the lighting pass found (sun visibility 1) and leaves ambient light, fog and the shadowed pixels
// alone. It augments the game's shadow maps rather than replacing them.
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform accelerationStructureEXT tlas;       // the scene BVH, view space
layout(binding = 1) uniform sampler2D lin_depth;                // the game's linear depth: view distance / far
layout(binding = 2, r11f_g11f_b10f) uniform image2D scene;      // the lit scene colour, darkened in place
layout(binding = 3) uniform sampler2D sun_vis;                  // half-resolution lighting: alpha is sun visibility

layout(push_constant) uniform Params {
    vec4 proj;    // projection x scale, y scale, far plane, strength (0..1)
    vec4 light;   // view-space direction toward the sun (xyz)
    vec4 size;    // width, height, 1/width, 1/height
    vec4 opt;     // x: debug (1: the shadow factor as grey), y: 1 with sun_vis bound
} pc;

vec3 view_pos(vec2 uv, float z) {   // z: distance in front of the camera
    vec2 ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * z / pc.proj.x, -ndc.y * z / pc.proj.y, -z);
}

vec3 pos_at(ivec2 q) {   // the view-space position of a pixel, clamped to the image
    q = clamp(q, ivec2(0), ivec2(pc.size.xy) - 1);
    return view_pos((vec2(q) + 0.5) * pc.size.zw, texelFetch(lin_depth, q, 0).x * pc.proj.z);
}

// The surface normal from the linear depth (contact_shadow.comp's): the neighbour nearer in depth on each axis, turned
// toward the camera.
vec3 normal_at(ivec2 px, vec3 p) {
    ivec2 last = ivec2(pc.size.xy) - 1;
    vec3 l = pos_at(px - ivec2(1, 0)), r = pos_at(px + ivec2(1, 0));
    vec3 d = pos_at(px - ivec2(0, 1)), u = pos_at(px + ivec2(0, 1));
    bool take_r = px.x == 0 || (px.x < last.x && abs(r.z - p.z) < abs(p.z - l.z));
    bool take_u = px.y == 0 || (px.y < last.y && abs(u.z - p.z) < abs(p.z - d.z));
    vec3 dx = take_r ? r - p : p - l;
    vec3 dy = take_u ? u - p : p - d;
    vec3 n = normalize(cross(dx, dy));
    return dot(n, p) > 0.0 ? -n : n;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(pc.size.x) || px.y >= int(pc.size.y)) return;
    float d = texelFetch(lin_depth, px, 0).x;
    if (d <= 0.0 || d >= 0.999) return;   // nothing drawn, or the sky
    float z = d * pc.proj.z;
    if (pc.opt.x > 2.5) {   // debug=3: does the BVH hold the surface the depth buffer holds? White: yes
        vec2 uvd = (vec2(px) + 0.5) * pc.size.zw;
        vec3 pd = view_pos(uvd, z);
        vec3 dir = normalize(pd);
        float len = length(pd);
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, tlas, gl_RayFlagsOpaqueEXT, 0xFF, dir * 0.1, 0.05, dir, len * 2.0);
        rayQueryProceedEXT(rq);
        uint type = rayQueryGetIntersectionTypeEXT(rq, true);
        float t = rayQueryGetIntersectionTEXT(rq, true);
        float ok = type != gl_RayQueryCommittedIntersectionNoneEXT && abs(t - len) < len * 0.15 + 0.5 ? 1.0 : 0.0;
        imageStore(scene, px, vec4(ok, ok, ok, 1.0));
        return;
    }
    if (z > 120.0) return;
    vec2 uv = (vec2(px) + 0.5) * pc.size.zw;
    float vis = pc.opt.y > 0.5 ? textureLod(sun_vis, uv, 0.0).a : 1.0;
    if (pc.opt.x > 1.5) {   // debug: the sun visibility the game's shadow maps give this pixel
        imageStore(scene, px, vec4(vis, vis, vis, 1.0));
        return;
    }
    if (vis <= 0.0 && pc.opt.x < 0.5) return;   // the shadow maps already shadow it: leave ambient light alone
    vec3 p = view_pos(uv, z);
    vec3 n = normal_at(px, p);
    // The shadow lands on the ground, not on the thin things that cast it: over a few pixels a leaf, a blade or an
    // edge leaves the plane its own depth gives, while the ground, water and stone stay on it. Darkening the thin ones
    // turned canopies and grass into black sheets.
    if (px.x < 8 || px.y < 8 || px.x > int(pc.size.x) - 9 || px.y > int(pc.size.y) - 9) return;
    vec3 q1 = pos_at(px + ivec2(8, 0)), q2 = pos_at(px + ivec2(0, 8));
    float tol = 0.1 + 0.02 * z;
    if (abs(dot(q1 - p, n)) > tol || abs(dot(q2 - p, n)) > tol) return;
    float lit = smoothstep(0.0, 0.3, dot(n, pc.light.xyz));
    float occ = 0.0;
    if (lit > 0.0 && (vis > 0.0 || pc.opt.x >= 0.5)) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, tlas, gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT, 0xFF,
                              p + n * 0.05, 0.02, pc.light.xyz, 250.0);
        rayQueryProceedEXT(rq);
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionNoneEXT) {
            // A hit right against the surface is the game's own shading's business: leaf cards and blades shadow
            // themselves with it, and painted black they read as sheets. This pass is for what the shadow maps miss
            // further out.
            float t = rayQueryGetIntersectionTEXT(rq, true);
            occ = t > 1.0 ? 1.0 : 0.0;
        }
    }
    float fade = 1.0 - smoothstep(80.0, 120.0, z);
    float k = 1.0 - pc.proj.w * occ * fade * lit * vis;
    if (pc.opt.x > 0.5) {   // debug: white where a ray hit, black where it left the scene, untouched elsewhere
        imageStore(scene, px, vec4(occ, occ, occ, 1.0));
        return;
    }
    if (k >= 0.999) return;
    vec4 c = imageLoad(scene, px);
    imageStore(scene, px, vec4(c.rgb * k, c.a));
}
